# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Environment variables
.env
.env.local
.env.production

# Virtual environments
.venv

# case
case/

docs/

_backup/

# fds file
*.fds
# Facility reference FDS files (geometry preview source, tracked on purpose)
!facilities/*.fds

# Demo videos and presentation renders (binary assets, too large for git)
video/*
!video/*.mp4
presentation/__pycache__/
presentation/rendered/

# Simulation results
results/

*.md
!presentation/README.md

# Agent damage raw case data (too large for git)
agent_damage/cases*/

# Agent damage training artifacts
agent_damage/checkpoints/*
!agent_damage/checkpoints/split_models/
agent_damage/data/
agent_damage/output/*
!agent_damage/output/split_model_evaluation.json
agent_damage/raw_results/
agent_damage/reports/*
!agent_damage/reports/*.md
!agent_damage/reports/*.docx
# Generated packaging staging is disposable; built artifacts stay out of git.
packaging/debroot/

# Project export artifacts
export/*.xlsx
projects/

.*/
!.github/
!.github/**
!README.md
!.env.example
!.gitignore
!.python-version
